{
  // The frontend is TypeScript only (docs/adr/0002-frontend-typescript.md):
  // tsc skips any .js file, so `make lint` refuses them under src/.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // `import.meta.env` and CSS imports, as Vite provides them
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
